{
  "name": "helios-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "pnpm --filter astris dev",
    "start": "pnpm dev",
    "build": "pnpm -r run build",
    "demo:build": "pnpm --filter astris build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test || true"
  },
  "devDependencies": {
    "pnpm": "10.0.0"
  }
}
